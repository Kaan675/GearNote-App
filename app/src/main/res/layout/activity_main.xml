<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C1C1E"
    android:padding="20dp"
    tools:context=".MainActivity">

    <!-- Sol Üst: Menü İkonu -->
    <ImageButton
        android:id="@+id/btnMenu"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Menü"
        android:src="@drawable/ic_menu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Sağ Üst: Logo ve GearNote Yazısı -->
    <LinearLayout
        android:id="@+id/layoutLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:contentDescription="GearNote Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_gearnote" />

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="GearNote"
            android:textColor="#D1D5DB"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Orta: ARAÇ EKLE Butonu -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddVehicle"
        android:layout_width="220dp"
        android:layout_height="56dp"
        android:backgroundTint="#B84A44"
        android:letterSpacing="0.05"
        android:text="ARAÇ EKLE"
        android:textColor="#F3F4F6"
        android:textSize="16sp"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>